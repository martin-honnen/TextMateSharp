{
"name": "XPath 3.1",
  "scopeName": "source.xpath",
  "fileTypes": [
    "xpath"
  ],
  "patterns": [
    { "include": "#comment" },
    { "include": "#strings" },
    { "include": "#variables" },
    { "include": "#numbers" },
    { "include": "#axes" },
    { "include": "#node-tests" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.xpath",
      "begin": "\\(:",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.xpath" }
      },
      "end": ":\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.xpath" }
      },
      "patterns": [
        { "include": "#comment" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.xpath",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xpath" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.xpath" } },
          "patterns": [
            {
              "name": "constant.character.escape.xpath",
              "match": "''"
            }
          ]
        },
        {
          "name": "string.quoted.double.xpath",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xpath" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.xpath" } },
          "patterns": [
            {
              "name": "constant.character.escape.xpath",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.xpath",
          "match": "\\$[A-Za-z_][\\w\\-\\.]*(:[A-Za-z_][\\w\\-\\.]*)?"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xpath",
          "match": "(?<![\\w\\$])(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+\\-]?\\d+)?"
        }
      ]
    },
    "axes": {
      "patterns": [
        {
          "name": "keyword.other.axis.xpath",
          "match": "\\b(ancestor|ancestor-or-self|attribute|child|descendant|descendant-or-self|following|following-sibling|parent|preceding|preceding-sibling|self)\\s*(?=::)"
        }
      ]
    },
    "node-tests": {
      "patterns": [
        {
          "name": "support.type.node.xpath",
          "match": "\\b(document-node|node|text|comment|processing-instruction|element|attribute|schema-element|schema-attribute)\\s*(?=\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.word.xpath",
          "match": "\\b(and|or|div|idiv|mod|intersect|except|union)\\b"
        },
        {
          "name": "keyword.control.conditional.xpath",
          "match": "\\b(if|then|else)\\b"
        },
        {
          "name": "keyword.control.quantifier.xpath",
          "match": "\\b(some|every|satisfies)\\b"
        },
        {
          "name": "keyword.control.binding.xpath",
          "match": "\\b(for|let|return|in|as|to)\\b"
        },
        {
          "name": "keyword.operator.type.xpath",
          "match": "\\b(instance|of|treat|castable|cast)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xpath",
          "match": "(=>|\\!|\\|\\||\\?|\\*\\*|\\.\\.|\\/\\/|\\/|\\*|\\+|\\-|<=|>=|!=|=|<|>)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.library.math.xpath",
          "match": "\\bmath:[A-Za-z_][\\w\\-\\.]*\\s*(?=\\()"
        },
        {
          "name": "support.function.library.map.xpath",
          "match": "\\bmap:[A-Za-z_][\\w\\-\\.]*\\s*(?=\\()"
        },
        {
          "name": "support.function.library.array.xpath",
          "match": "\\barray:[A-Za-z_][\\w\\-\\.]*\\s*(?=\\()"
        },
        {
          "name": "support.function.library.fn.xpath",
          "match": "\\bfn:(?:(?:abs|adjust-date-to-timezone|adjust-dateTime-to-timezone|adjust-time-to-timezone|analyze-string|apply|available-environment-variables|avg|base-uri|boolean|ceiling|codepoint-equal|codepoints-to-string|collection|compare|concat|contains|contains-token|current-date|current-dateTime|current-time|data|dateTime|days-from-duration|deep-equal|default-collation|default-language|distinct-values|doc|doc-available|document-uri|empty|encode-for-uri|ends-with|environment-variable|error|escape-html-uri|exists|exactly-one|false|filter|floor|fold-left|fold-right|for-each|for-each-pair|format-date|format-dateTime|format-integer|format-number|function-arity|function-lookup|function-name|head|hours-from-dateTime|hours-from-duration|hours-from-time|id|idref|implicit-timezone|in-scope-prefixes|index-of|insert-before|iri-to-uri|json-doc|json-to-xml|lang|last|load-xquery-module|local-name|local-name-from-QName|lower-case|max|min|minutes-from-dateTime|minutes-from-duration|minutes-from-time|month-from-date|month-from-dateTime|months-from-duration|name|namespace-uri|namespace-uri-for-prefix|namespace-uri-from-QName|node-name|nilled|normalize-space|normalize-unicode|not|number|one-or-more|outermost|innermost|parse-json|parse-xml|parse-xml-fragment|path|position|prefix-from-QName|random-number-generator|remove|replace|resolve-QName|resolve-uri|reverse|root|round|round-half-to-even|round-half-to-odd|seconds-from-dateTime|seconds-from-duration|seconds-from-time|serialize|starts-with|static-base-uri|string|string-join|string-length|string-to-codepoints|subsequence|sum|tail|timezone-from-date|timezone-from-dateTime|timezone-from-time|tokenize|trace|translate|true|unordered|upper-case|uri-collection|year-from-date|year-from-dateTime|years-from-duration|unparsed-text|unparsed-text-available|unparsed-text-lines|unparsed-entity-uri|unparsed-entity-public-id))\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.xpath",
          "match": "\\b(?:abs|adjust-date-to-timezone|adjust-dateTime-to-timezone|adjust-time-to-timezone|analyze-string|apply|available-environment-variables|avg|base-uri|boolean|ceiling|codepoint-equal|codepoints-to-string|collection|compare|concat|contains|contains-token|current-date|current-dateTime|current-time|data|dateTime|days-from-duration|deep-equal|default-collation|default-language|distinct-values|doc|doc-available|document-uri|empty|encode-for-uri|ends-with|environment-variable|error|escape-html-uri|exists|exactly-one|false|filter|floor|fold-left|fold-right|for-each|for-each-pair|format-date|format-dateTime|format-integer|format-number|function-arity|function-lookup|function-name|head|hours-from-dateTime|hours-from-duration|hours-from-time|id|idref|implicit-timezone|in-scope-prefixes|index-of|insert-before|iri-to-uri|json-doc|json-to-xml|lang|last|load-xquery-module|local-name|local-name-from-QName|lower-case|max|min|minutes-from-dateTime|minutes-from-duration|minutes-from-time|month-from-date|month-from-dateTime|months-from-duration|name|namespace-uri|namespace-uri-for-prefix|namespace-uri-from-QName|node-name|nilled|normalize-space|normalize-unicode|not|number|one-or-more|outermost|innermost|parse-json|parse-xml|parse-xml-fragment|path|position|prefix-from-QName|random-number-generator|remove|replace|resolve-QName|resolve-uri|reverse|root|round|round-half-to-even|round-half-to-odd|seconds-from-dateTime|seconds-from-duration|seconds-from-time|serialize|starts-with|static-base-uri|string|string-join|string-length|string-to-codepoints|subsequence|sum|tail|timezone-from-date|timezone-from-dateTime|timezone-from-time|tokenize|trace|translate|true|unordered|upper-case|uri-collection|year-from-date|year-from-dateTime|years-from-duration|unparsed-text|unparsed-text-available|unparsed-text-lines|unparsed-entity-uri|unparsed-entity-public-id)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.xpath",
          "match": "\\b[A-Za-z_][\\w\\-\\.]*(:[A-Za-z_][\\w\\-\\.]*)?\\s*(?=\\()"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.begin.xpath",
          "match": "\\("
        },
        {
          "name": "punctuation.section.group.end.xpath",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.xpath",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.xpath",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.xpath",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.xpath",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.sequence.xpath",
          "match": ","
        },
        {
          "name": "punctuation.separator.key-value.xpath",
          "match": ":"
        }
      ]
    }
  },
  "uuid": "6f2f9c0e-9d9f-4a9a-9a1f-56d2e3b0d3a1",
  "version": "0.3.0"
}